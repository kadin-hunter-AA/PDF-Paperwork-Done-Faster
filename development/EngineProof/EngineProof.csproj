<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../native/bin/pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Update="nested_text.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../tools/python-packages/pypdf/**/*.py" Link="python-packages/pypdf/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../tools/python-packages/pypdf-6.1.3.dist-info/licenses/**/*" Link="python-packages/pypdf-6.1.3.dist-info/licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
