                                        <Rectangle Style="{StaticResource MenuSeparator}"/>
                                        <Button Content="Edit bookmarks…" Tag="M7 4h10v16l-5-4-5 4z" CommandParameter="Bookmarks" Style="{StaticResource MenuRow}" Click="QuickTool_Click"
                                                ToolTip="Add, rename, reorder, nest and delete bookmarks" AutomationProperties.Name="Edit bookmarks"/>
                                        <Button Content="Links on this page…" Tag="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" CommandParameter="Links" Style="{StaticResource MenuRow}" Click="QuickTool_Click"
                                                ToolTip="Add or remove web and page links" AutomationProperties.Name="Links on this page"/>
                                        <Button Content="Document properties…" Tag="M5 4h14v16H5zM8 9h8M8 13h8M8 17h5" CommandParameter="Properties" Style="{StaticResource MenuRow}" Click="QuickTool_Click"
