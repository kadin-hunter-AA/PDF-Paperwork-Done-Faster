                                        <Button Content="Underline" Tag="M7 4v7a5 5 0 0 0 10 0V4M5 20h14" CommandParameter="Underline" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag across text to underline it" AutomationProperties.Name="Underline text tool"/>
                                        <Button Content="Strikeout" Tag="M4 12h16M16 7c-1-1.5-2.5-2-4-2-2.5 0-4.5 1.3-4.5 3.3M8 17c1 1.5 2.5 2 4 2 2.5 0 4.5-1.3 4.5-3.3" CommandParameter="Strikeout" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag across text to strike it out" AutomationProperties.Name="Strikeout text tool"/>
                                        <Button Content="Sticky note" Tag="M4 5.5h16v11h-9l-5 4v-4H4z" CommandParameter="Note" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Click to place a sticky note and type the comment" AutomationProperties.Name="Sticky note tool"/>
                                        <Rectangle Style="{StaticResource MenuSeparator}"/>
                                        <Button Content="Manage annotations…" Tag="M4 6h16M4 12h16M4 18h10" Style="{StaticResource MenuRow}" Click="ManageAnnotations_Click"
                                                ToolTip="Edit note text or delete notes and text markup already on this page" AutomationProperties.Name="Manage existing annotations on the current page"/>
                                        <Button x:Name="MarkupButton" Content="Mark up selection or area…" Tag="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5M9 9h6v6H9z" Style="{StaticResource MenuRow}" Click="Markup_Click"
                                                ToolTip="Add text markup or a sticky note to selected text or an exact page rectangle" AutomationProperties.Name="Add text markup or a sticky note annotation to the current page"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="DrawMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=DrawMenu}"
                                          ToolTip="Draw: freehand pen, lines, arrows and shapes" AutomationProperties.Name="Draw menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M2.5 16c3-11 6-11 8-4s5 6 7-3c1-4 3-4 4.5-1"/><AccessText Text="_Draw" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="DrawMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=DrawMenuButton}" IsOpen="{Binding IsChecked, ElementName=DrawMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <TextBlock Text="Draw" Style="{StaticResource MenuHeader}"/>
                                        <Button Content="Pen" Tag="M2.5 16c3-11 6-11 8-4s5 6 7-3c1-4 3-4 4.5-1" CommandParameter="Pen" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Draw freehand on the page" AutomationProperties.Name="Freehand pen tool"/>
                                        <Button Content="Line" Tag="M4 19L20 5" CommandParameter="Line" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag to draw a straight line" AutomationProperties.Name="Line tool"/>
                                        <Button Content="Arrow" Tag="M4 19L20 5M11 5h9v9" CommandParameter="Arrow" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag to draw an arrow pointing where you release" AutomationProperties.Name="Arrow tool"/>
                                        <Button Content="Rectangle" Tag="M3.5 6h17v12h-17z" CommandParameter="Rectangle" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag to draw a rectangle" AutomationProperties.Name="Rectangle tool"/>
                                        <Button Content="Ellipse" Tag="M12 18.5c4.7 0 8.5-2.9 8.5-6.5S16.7 5.5 12 5.5 3.5 8.4 3.5 12s3.8 6.5 8.5 6.5z" CommandParameter="Ellipse" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag to draw an ellipse" AutomationProperties.Name="Ellipse tool"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="RedactMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=RedactMenu}"
                                          ToolTip="Redact: preview marked content, then remove it permanently in a new copy" AutomationProperties.Name="Redact menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M3.5 6.5h17v4h-17zM3.5 14h10v4h-10zM17 16h3.5"/><AccessText Text="_Redact" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="RedactMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=RedactMenuButton}" IsOpen="{Binding IsChecked, ElementName=RedactMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <TextBlock Text="Redact" Style="{StaticResource MenuHeader}"/>
                                        <Button x:Name="RedactionButton" Content="Permanent redaction…" Tag="M3.5 6.5h17v4h-17zM3.5 14h10v4h-10zM17 16h3.5" Style="{StaticResource MenuRow}" Click="Redaction_Click"
                                                ToolTip="Preview what will be removed, then save a new redacted copy. The open document is not changed." AutomationProperties.Name="Preview permanent redaction and create a new PDF"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ToolsMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=ToolsMenu}"
                                          ToolTip="Tools: compress, protect, watermark, page numbers, bookmarks, export and more" AutomationProperties.Name="Tools menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M14 6l4 4-8 8H6v-4zM4 20h16"/><AccessText Text="_Tools" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="ToolsMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=ToolsMenuButton}" IsOpen="{Binding IsChecked, ElementName=ToolsMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
