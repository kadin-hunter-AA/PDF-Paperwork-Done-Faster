<Window x:Class="HunterPdf.Desktop.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HunterPdf.Desktop"
        Title="PDF - Paperwork Done Faster" Icon="/App.Desktop;component/Assets/PdfEditor-256.png" Width="1280" Height="860" MinWidth="760" MinHeight="520"
        FontFamily="Avenir Next, Avenir, Segoe UI" FontSize="{DynamicResource UiFontSize}" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextBrush}" AllowDrop="True"
        PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop" SizeChanged="Window_SizeChanged" AutomationProperties.Name="PDF - Paperwork Done Faster">
    <!-- Layout follows the PDF Workspace design (design/claude-design, variant 4a). Sizes, text sizes and menu labels come
         from theme resources: Graphite uses the design's compact density; the brand themes keep 44 DIP targets and labels. -->
    <Window.Resources>
        <Style x:Key="KeyboardFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Control">
                    <Rectangle Margin="1" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"/>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaseControl" TargetType="Control">
            <Setter Property="FontFamily" Value="Avenir Next, Avenir, Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/><Setter Property="Opacity" Value=".6"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToolBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Mode-bar tools: outlined chips with an icon and short label; the active tool is tinted in the accent color. -->
        <Style x:Key="PageToolButton" TargetType="RadioButton" BasedOn="{StaticResource BaseControl}">
            <Setter Property="GroupName" Value="PageTools"/>
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="{DynamicResource ChipHeight}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Frame" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToolBrush}"/>
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="{DynamicResource ChipHeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="MinHeight" Value="{DynamicResource ChipHeight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource BaseControl}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding FullPath}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource TintBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Page thumbnails: two columns of white pages with the page number underneath, as in the design. -->
        <Style x:Key="ThumbnailItem" TargetType="ListBoxItem" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Padding" Value="4,8,4,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource TintBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Frame" Background="{DynamicResource PopupBrush}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource TintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" BorderBrush="{DynamicResource LineBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <local:StrokeIcon Grid.Column="1" Size="12" Data="M7 10l5 5 5-5" HorizontalAlignment="Right"/>
                        </Grid>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                            <ScrollViewer><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Panel tabs: plain labels with an accent underline on the selected view. -->
        <Style TargetType="TabItem" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="{DynamicResource TabHeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="0,0,0,1" Padding="4,0">
                        <!-- Wraps to a second row in a narrow panel so no tab is hidden. -->
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    <ContentPresenter ContentSource="SelectedContent"/>
                </DockPanel>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Document tabs sit on the darkest strip; the active tab joins the command row below it. -->
        <Style x:Key="DocumentTabItem" TargetType="TabItem" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Padding" Value="12,0,6,0"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding FullPath}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ChromeLineBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2,2,2,0"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Icon-only commands; their names and shortcuts are in tooltips and automation names. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="{DynamicResource ControlHeight}"/>
        </Style>
        <Style x:Key="ChromeSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Fill" Value="{DynamicResource ChromeLineBrush}"/>
        </Style>
        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MenuLabel" TargetType="AccessText">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="{DynamicResource MenuLabelVisibility}"/>
        </Style>
        <!-- Task menus: an icon (and, in the brand themes, a label) that opens a list of commands. Tag holds the popup
             so the button ignores the click that closes it instead of reopening the list. -->
        <local:InverseBooleanConverter x:Key="Not"/>
        <Style x:Key="MenuToggle" TargetType="ToggleButton" BasedOn="{StaticResource BaseControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,0,3,0"/>
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsHitTestVisible" Value="{Binding Tag.IsOpen, RelativeSource={RelativeSource Self}, Converter={StaticResource Not}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center"/>
                        <local:StrokeIcon Data="M7 10l5 5 5-5" Size="13" Margin="1,0,0,0" Opacity=".75"/>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MenuPopup" TargetType="Popup">
            <Setter Property="StaysOpen" Value="False"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="PopupAnimation" Value="None"/>
            <Setter Property="VerticalOffset" Value="6"/>
        </Style>
        <Style x:Key="MenuPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="284"/>
        </Style>
        <Style x:Key="MenuHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="10,6,10,5"/>
        </Style>
        <Style x:Key="MenuSeparator" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,5"/>
            <Setter Property="Fill" Value="{DynamicResource ChromeLineBrush}"/>
        </Style>
        <!-- Menu rows: Tag is the icon outline; the accelerator key is shown on the right and read by screen readers. -->
        <Style x:Key="MenuRow" TargetType="Button" BasedOn="{StaticResource BaseControl}">
            <Setter Property="MinHeight" Value="{DynamicResource RowHeight}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <local:StrokeIcon DockPanel.Dock="Left" Margin="0,0,10,0" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock DockPanel.Dock="Right" Margin="18,0,0,0" FontSize="{DynamicResource SmallFontSize}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding (AutomationProperties.AcceleratorKey), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </DockPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Properties rows: muted name on the left, value on the right. -->
        <Style x:Key="PropertyName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="PropertyValue" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PropertyRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="ApplicationCommands.SaveAs"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo"/>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
        <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy"/>
        <KeyBinding Key="W" Modifiers="Control" Command="ApplicationCommands.Close"/>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{x:Static local:ShellCommands.NextTab}"/>
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{x:Static local:ShellCommands.PreviousTab}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="ApplicationCommands.Redo"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static local:ShellCommands.ZoomIn}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:ShellCommands.ZoomIn}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static local:ShellCommands.ZoomOut}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:ShellCommands.ZoomOut}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:ShellCommands.FitPage}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static local:ShellCommands.FitPage}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:ShellCommands.ActualSize}"/>
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{x:Static local:ShellCommands.ActualSize}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:ShellCommands.FitWidth}"/>
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{x:Static local:ShellCommands.FitWidth}"/>
        <KeyBinding Key="G" Modifiers="Control" Command="{x:Static local:ShellCommands.GoToPage}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static local:ShellCommands.Print}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{x:Static local:ShellCommands.RotateClockwise}"/>
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{x:Static local:ShellCommands.RotateCounterclockwise}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Control" Command="{x:Static local:ShellCommands.RotateClockwise}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Control" Command="{x:Static local:ShellCommands.RotateCounterclockwise}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="ApplicationCommands.SaveAs"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{x:Static local:ShellCommands.ToggleNavigation}"/>
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{x:Static local:ShellCommands.ToggleSidePanel}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Document tabs -->
        <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="0,0,0,1" Padding="8,4,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Theme" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SmallFontSize}" VerticalAlignment="Center" Margin="8,0"/>
                    <ComboBox x:Name="ThemeChoice" Width="112" VerticalAlignment="Center" SelectionChanged="Theme_Changed" AutomationProperties.Name="Application theme"/>
                    <TextBlock x:Name="ContrastLabel" Text="Windows high contrast" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <DockPanel HorizontalAlignment="Left">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="ApplicationCommands.Open" CommandTarget="{Binding ElementName=RootWindow}"
                            VerticalAlignment="Top" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}" ToolTip="Open PDF (Ctrl+O)" AutomationProperties.Name="Open a PDF in a new tab">
                        <local:StrokeIcon Data="M12 5v14M5 12h14" Size="14"/>
                    </Button>
                    <TabControl x:Name="DocumentTabs" SelectionChanged="DocumentSelection_Changed" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Document tabs"
                                KeyboardNavigation.TabNavigation="Once" ItemContainerStyle="{StaticResource DocumentTabItem}">
                        <TabControl.Template><ControlTemplate TargetType="TabControl">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                                <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </ControlTemplate></TabControl.Template>
                        <TabControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:StrokeIcon Data="M6 3h8l4 4v14H6zM14 3v4h4" Size="14" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Header}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FullPath}"/>
                                <Button Style="{StaticResource IconButton}" MinWidth="24" MinHeight="24" Tag="{Binding}" Click="CloseTab_Click" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"
                                        ToolTip="Close document (Ctrl+W)" AutomationProperties.Name="{Binding Header, StringFormat=Close {0}}">
                                    <local:StrokeIcon Data="M6 6l12 12M18 6L6 18" Size="12"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate></TabControl.ItemTemplate>
                    </TabControl>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Command row: panel and File on the left with save state; Select/Edit and task menus in the middle;
             history, find, page navigation, the properties panel and Save on the right. -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid x:Name="CommandBar" SizeChanged="CommandBar_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="CommandLeft" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="NavigationToggle" Style="{StaticResource IconToggle}" IsChecked="True" Click="Panels_Changed"
                                  ToolTip="Page sidebar (Ctrl+B): pages, bookmarks and open documents" AutomationProperties.Name="Show navigation panel">
                        <local:StrokeIcon Data="M3.5 4.5h17v15h-17zM9 4.5v15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="FileMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=FileMenu}" Margin="4,0,0,0"
                                  ToolTip="File: open, save, combine, print and recover documents" AutomationProperties.Name="File menu">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M6 3h8l4 4v14H6zM14 3v4h4"/><AccessText Text="_File" Style="{StaticResource MenuLabel}"/></StackPanel>
                    </ToggleButton>
                    <Popup x:Name="FileMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=FileMenuButton}" IsOpen="{Binding IsChecked, ElementName=FileMenuButton, Mode=TwoWay}"
                           Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                        <Border Style="{StaticResource MenuPanel}">
                            <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                <TextBlock Text="File" Style="{StaticResource MenuHeader}"/>
                                <Button x:Name="OpenButton" Content="Open PDF…" Tag="M3 7V5h7l2 2h9v12H3z" Style="{StaticResource MenuRow}" Command="ApplicationCommands.Open" CommandTarget="{Binding ElementName=RootWindow}"
                                        AutomationProperties.AcceleratorKey="Ctrl+O" ToolTip="Open a PDF from this computer" AutomationProperties.Name="Open PDF"/>
                                <Button x:Name="SaveAsButton" Content="Save as…" Tag="M5 4h11l3 3v13H5zM8 4v5h7M8 20v-6h8v6" Style="{StaticResource MenuRow}" Command="ApplicationCommands.SaveAs" CommandTarget="{Binding ElementName=RootWindow}"
                                        AutomationProperties.AcceleratorKey="Ctrl+Shift+S" ToolTip="Save a copy under a new name (Ctrl+Shift+S or Ctrl+E)" AutomationProperties.Name="Save PDF as"/>
                                <Rectangle Style="{StaticResource MenuSeparator}"/>
                                <Button x:Name="CombineButton" Content="Combine PDFs…" Tag="M4 4h7v16H4zM13 4h7v16h-7z" Style="{StaticResource MenuRow}" Click="Combine_Click"
                                        ToolTip="Merge several PDFs into one new document" AutomationProperties.Name="Combine PDF files"/>
                                <Button x:Name="PrintButton" Content="Print…" Tag="M7 9V4h10v5M6 17H4v-7h16v7h-2M7 14h10v6H7z" Style="{StaticResource MenuRow}" Click="Print_Click" AutomationProperties.AcceleratorKey="Ctrl+P"
                                        ToolTip="Preview and print this document (Ctrl+P)" AutomationProperties.Name="Print current PDF"/>
                                <Button x:Name="CompactHistoryButton" Content="Free undo storage…" Tag="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" Style="{StaticResource MenuRow}" Click="CompactHistory_Click"
                                        ToolTip="Remove older undo steps for this document to free disk space. The current version and the saved and original versions are kept." AutomationProperties.Name="Free undo storage for this document"/>
                                <Rectangle Style="{StaticResource MenuSeparator}"/>
                                <Button Content="Recover documents…" Tag="M4 12a8 8 0 1 0 2.4-5.7L4 8.5M4 3.5v5h5M12 8v4l3 2" Style="{StaticResource MenuRow}" Click="Recover_Click"
                                        ToolTip="Reopen documents left unsaved after the app closed unexpectedly" AutomationProperties.Name="Recover abandoned documents"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <StackPanel x:Name="SaveIndicator" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0" Visibility="Collapsed" AutomationProperties.Name="Save state">
                        <Ellipse x:Name="SaveDot" Width="7" Height="7" Fill="{DynamicResource SavedBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SaveState" Text="All changes saved" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel x:Name="CommandCenter" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="SelectModeToggle" Style="{StaticResource IconToggle}" IsChecked="True" Click="SelectMode_Click"
                                          ToolTip="Select: select and copy text on the page" AutomationProperties.Name="Select text tool">
                                <local:StrokeIcon Data="M5.5 3.5l13 7-5.6 1.8-2.9 5.7z"/>
                            </ToggleButton>
                            <ToggleButton x:Name="HandToolToggle" Style="{StaticResource IconToggle}" Click="HandTool_Click" Margin="2,0,0,0"
                                          ToolTip="Hand (H): drag to pan the page. Hold Space for a temporary pan" AutomationProperties.Name="Hand tool" AutomationProperties.AcceleratorKey="H">
                                <local:StrokeIcon Data="M8 12.5V6a1.5 1.5 0 0 1 3 0v5M11 10.5V4.5a1.5 1.5 0 0 1 3 0v6M14 10.5V6a1.5 1.5 0 0 1 3 0v7.5a6.5 6.5 0 0 1-6.5 6.5h-.6a6 6 0 0 1-4.9-2.6L4.3 14.6a1.5 1.5 0 0 1 2.4-1.8L8 14.5"/>
                            </ToggleButton>
                            <ToggleButton x:Name="EditModeToggle" Style="{StaticResource IconToggle}" Click="EditMode_Click" Padding="7,0" Margin="2,0,0,0"
                                          ToolTip="Edit: change text, add text, highlight, notes and drawings directly on the page." AutomationProperties.Name="Edit this PDF on the page">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 20h4L19 9l-4-4L4 16zM13 7l4 4"/><AccessText Text="Edit" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SegmentGroup}">
                        <WrapPanel x:Name="ModeMenus">
                            <ToggleButton x:Name="PagesMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=PagesMenu}"
                                          ToolTip="Pages: organize and rotate pages" AutomationProperties.Name="Pages menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M8 3h11v14H8zM5 7v14h11"/><AccessText Text="_Pages" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="PagesMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=PagesMenuButton}" IsOpen="{Binding IsChecked, ElementName=PagesMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <TextBlock Text="Pages" Style="{StaticResource MenuHeader}"/>
                                        <Button x:Name="PageOrganizerButton" Content="Organize pages…" Tag="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" Style="{StaticResource MenuRow}" Click="PageOrganizer_Click"
                                                ToolTip="Reorder, duplicate, delete, import, insert, extract or split pages" AutomationProperties.Name="Reorder, duplicate, delete, import, or insert PDF pages"/>
                                        <Button x:Name="RotateButton" Content="Rotate current page" Tag="M20 12a8 8 0 1 1-2.4-5.7L20 8.5M20 3.5v5h-5" Style="{StaticResource MenuRow}" Click="Rotate_Click"
                                                ToolTip="Rotate the current page, or the selected thumbnails, 90° clockwise (Ctrl+R)" AutomationProperties.Name="Rotate current page clockwise"/>
                                        <Button x:Name="RotateAllButton" Content="Rotate all pages" Tag="M20 12a8 8 0 1 1-2.4-5.7L20 8.5M20 3.5v5h-5" Style="{StaticResource MenuRow}" Click="RotateAll_Click"
                                                ToolTip="Rotate every page 90° clockwise as one change" AutomationProperties.Name="Rotate all pages clockwise"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ContentMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=ContentMenu}"
                                          ToolTip="Edit content: change existing text, add text and edit images" AutomationProperties.Name="Edit content menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 7V4h12v3M10 4v16M7.5 20h5M14.5 19l5.5-5.5 1.5 1.5-5.5 5.5h-1.5z"/><AccessText Text="Edit _content" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="ContentMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=ContentMenuButton}" IsOpen="{Binding IsChecked, ElementName=ContentMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <TextBlock Text="Edit content" Style="{StaticResource MenuHeader}"/>
                                        <Button Content="Edit existing text" Tag="M4 20h4L19 9l-4-4L4 16zM13 7l4 4" CommandParameter="EditText" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Click existing text on the page and type to change it" AutomationProperties.Name="Edit existing text tool"/>
                                        <Button Content="Add text" Tag="M5 7V4.5h11V7M10.5 4.5v15M8 19.5h5M18.5 13v7M15 16.5h7" CommandParameter="AddText" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Click anywhere on the page and type new text" AutomationProperties.Name="Add new text tool"/>
                                        <Button Content="Text box" Tag="M3.5 5.5h17v13h-17zM8 9.5h8M12 9.5v6" CommandParameter="TextBox" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
                                                ToolTip="Drag a box, then type one line of text inside it" AutomationProperties.Name="Text box tool"/>
                                        <Rectangle Style="{StaticResource MenuSeparator}"/>
                                        <Button x:Name="ImageEditorButton" Content="Edit or add images…" Tag="M4 5h16v14H4zM4 16l5-5 4 4 2-2 5 5M15.5 9.5h.01" Style="{StaticResource MenuRow}" Click="ImageEditor_Click"
                                                ToolTip="Replace, move, resize or delete images on this page" AutomationProperties.Name="Edit or add an image on the current page"/>
                                        <Button x:Name="EditExistingTextButton" Content="Edit page objects…" Tag="M5 5h6v6H5zM13 13h6v6h-6zM11 8h5v5" Style="{StaticResource MenuRow}" Click="EditExistingText_Click"
                                                ToolTip="Pick an existing text object on this page from a list" AutomationProperties.Name="Edit an existing text object on the current page"/>
                                        <Rectangle Style="{StaticResource MenuSeparator}"/>
                                        <Button x:Name="OcrButton" Content="Recognize scan text…" Tag="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 12h8" Style="{StaticResource MenuRow}" Click="Ocr_Click"
                                                ToolTip="Make a scanned page searchable with local English text recognition" AutomationProperties.Name="Recognize English text in a scanned PDF locally"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="AnnotateMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=AnnotateMenu}"
                                          ToolTip="Annotate: highlight, underline, strike out and add notes" AutomationProperties.Name="Annotate menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M15 4.5l4.5 4.5-8 8H7v-4.5zM4 21h16"/><AccessText Text="_Annotate" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="AnnotateMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=AnnotateMenuButton}" IsOpen="{Binding IsChecked, ElementName=AnnotateMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <TextBlock Text="Annotate" Style="{StaticResource MenuHeader}"/>
                                        <Button Content="Highlight" Tag="M15 4.5l4.5 4.5-8 8H7v-4.5zM4 21h16" CommandParameter="Highlight" Style="{StaticResource MenuRow}" Click="MenuTool_Click"
