                                        <Button Content="Flatten to new copy…" Tag="M4 8l8-4 8 4-8 4zM4 12l8 4 8-4M4 16l8 4 8-4" CommandParameter="Flatten" Style="{StaticResource MenuRow}" Click="QuickTool_Click"
                                                ToolTip="Merge form fields and annotations into the page content in a new copy" AutomationProperties.Name="Flatten to new copy"/>
                                        <Button Content="Export pages as images…" Tag="M4 5h16v14H4zM4 16l5-5 4 4 2-2 5 5" CommandParameter="ExportImages" Style="{StaticResource MenuRow}" Click="QuickTool_Click"
                                                ToolTip="Save pages as PNG or JPEG files" AutomationProperties.Name="Export pages as images"/>
                                        <Button Content="Extract images…" Tag="M4 5h10v10H4zM10 9h10v10H10z" CommandParameter="ExtractImages" Style="{StaticResource MenuRow}" Click="QuickTool_Click"
                                                ToolTip="Save the images embedded in the pages" AutomationProperties.Name="Extract images"/>
                                        <Rectangle Style="{StaticResource MenuSeparator}"/>
                                        <Button x:Name="CompareButton" Content="Compare with another PDF…" Tag="M4 4h7v16H4zM13 4h7v16h-7zM6.5 9h2M15.5 9h2M6.5 13h2M15.5 13h2" Style="{StaticResource MenuRow}" Click="Compare_Click"
                                                ToolTip="Show which pages differ in text or appearance from another PDF. Neither file is changed." AutomationProperties.Name="Compare with another PDF"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="FormsMenuButton" Style="{StaticResource MenuToggle}" Tag="{Binding ElementName=FormsMenu}"
                                          ToolTip="Forms &amp; sign: fill existing forms and create a signed copy" AutomationProperties.Name="Forms and sign menu">
                                <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M3 17c3-5 5-5 5.5-2s2 3 4-2 3-3 3.5 0 2 1 4 0M3 21h18"/><AccessText Text="F_orms &amp; sign" Style="{StaticResource MenuLabel}"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="FormsMenu" Style="{StaticResource MenuPopup}" PlacementTarget="{Binding ElementName=FormsMenuButton}" IsOpen="{Binding IsChecked, ElementName=FormsMenuButton, Mode=TwoWay}"
                                   Opened="MenuPopup_Opened" KeyDown="MenuPopup_KeyDown" ButtonBase.Click="MenuPopup_Click">
                                <Border Style="{StaticResource MenuPanel}">
                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <TextBlock Text="Forms &amp; sign" Style="{StaticResource MenuHeader}"/>
                                        <Button x:Name="AddSignatureButton" Content="Add signature…" Tag="M3 17c3-5 5-5 5.5-2s2 3 4-2 3-3 3.5 0 2 1 4 0M3 21h18" Style="{StaticResource MenuRow}" Click="AddSignature_Click"
                                                ToolTip="Draw, type or import a visual signature, then click where it goes. This is an image, not a digital signature." AutomationProperties.Name="Add a visual signature (not a digital signature)"/>
                                        <Button x:Name="AddInitialsButton" Content="Add initials…" Tag="M5 18V6l5 12V6M14 18V6h4a3 3 0 0 1 0 6h-4" Style="{StaticResource MenuRow}" Click="AddInitials_Click"
                                                ToolTip="Draw, type or import your initials, then click where they go" AutomationProperties.Name="Add visual initials"/>
                                        <Button x:Name="SavedSignatureButton" Content="Use a saved signature…" Tag="M5 4h11l3 3v13H5zM8 13c2-3 3-3 3.5-1s1.5 2 3-1" Style="{StaticResource MenuRow}" Click="SavedSignature_Click"
                                                ToolTip="Place a signature or initials you saved earlier" AutomationProperties.Name="Place a saved visual signature"/>
                                        <Button x:Name="DateStampButton" Content="Date" Tag="M4 6h16v14H4zM4 10h16M8 3v5M16 3v5" Style="{StaticResource MenuRow}" Click="DateStamp_Click"
                                                ToolTip="Click to place today's date" AutomationProperties.Name="Place today's date"/>
                                        <Button x:Name="CheckStampButton" Content="Check mark ✓" Tag="M5 12l4 4 10-10" Style="{StaticResource MenuRow}" Click="CheckStamp_Click"
                                                ToolTip="Click to place a check mark" AutomationProperties.Name="Place a check mark"/>
                                        <Button x:Name="CrossStampButton" Content="Cross mark ✗" Tag="M6 6l12 12M18 6L6 18" Style="{StaticResource MenuRow}" Click="CrossStamp_Click"
                                                ToolTip="Click to place a cross mark" AutomationProperties.Name="Place a cross mark"/>
                                        <Rectangle Style="{StaticResource MenuSeparator}"/>
                                        <Button x:Name="FillFormButton" Content="Fill existing form…" Tag="M4 5h16v5H4zM4 14h16v5H4zM7 7.5h5M7 16.5h5" Style="{StaticResource MenuRow}" Click="FillForm_Click"
                                                ToolTip="Fill text fields and checkboxes in an existing PDF form" AutomationProperties.Name="Fill an existing PDF text field or checkbox"/>
                                        <Button x:Name="SignCopyButton" Content="Create signed copy…" Tag="M3 17c3-5 5-5 5.5-2s2 3 4-2 3-3 3.5 0 2 1 4 0M3 21h18" Style="{StaticResource MenuRow}" Click="SignCopy_Click"
                                                ToolTip="Create a new certificate-signed copy. This document is not changed." AutomationProperties.Name="Create a new certificate-signed PDF copy"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </WrapPanel>
                    </Border>
                </WrapPanel>

                <StackPanel x:Name="CommandTools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=RootWindow}"
                            ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo edit">
                        <local:StrokeIcon Data="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=RootWindow}"
                            ToolTip="Redo (Ctrl+Y or Ctrl+Shift+Z)" AutomationProperties.Name="Redo edit">
                        <local:StrokeIcon Data="M15 14l5-5-5-5M20 9H9a5 5 0 0 0 0 10h3"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="ApplicationCommands.Find" CommandTarget="{Binding ElementName=RootWindow}"
                            ToolTip="Find in document (Ctrl+F)" AutomationProperties.Name="Find text in this PDF">
                        <local:StrokeIcon Data="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM15.5 15.5L20 20"/>
                    </Button>
                    <StackPanel x:Name="PageNavigation" Orientation="Horizontal" Visibility="Collapsed">
                        <Rectangle Style="{StaticResource ChromeSeparator}"/>
                        <Button x:Name="PreviousPageButton" Style="{StaticResource IconButton}" Click="PreviousPage_Click" ToolTip="Previous page (Page Up)" AutomationProperties.Name="Previous page">
                            <local:StrokeIcon Data="M15 6l-6 6 6 6"/>
                        </Button>
                        <TextBox x:Name="PageNumberBox" MinWidth="40" Text="1" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="4,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Current page number" KeyDown="PageNumber_KeyDown" ToolTip="Go to page (Ctrl+G)"/>
                        <TextBlock x:Name="PageCountLabel" Text="/ 1" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="{DynamicResource MutedBrush}"/>
                        <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" Click="NextPage_Click" ToolTip="Next page (Page Down)" AutomationProperties.Name="Next page">
                            <local:StrokeIcon Data="M9 6l6 6-6 6"/>
                        </Button>
                    </StackPanel>
                    <Rectangle Style="{StaticResource ChromeSeparator}"/>
                    <ToggleButton x:Name="PropertiesToggle" Style="{StaticResource IconToggle}" IsChecked="True" Click="Panels_Changed" Margin="0,0,6,0"
                                  ToolTip="Side panel (Ctrl+Shift+B): annotations, page contents and properties" AutomationProperties.Name="Show properties panel">
                        <local:StrokeIcon Data="M3.5 4.5h17v15h-17zM15 4.5v15"/>
                    </ToggleButton>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Command="ApplicationCommands.Save" CommandTarget="{Binding ElementName=RootWindow}"
                            Padding="12,0" BorderThickness="0" ToolTip="Save changes to this PDF (Ctrl+S)" AutomationProperties.Name="Save PDF">
                        <StackPanel Orientation="Horizontal">
                            <local:StrokeIcon Data="M5 4h11l3 3v13H5zM8 4v5h7M8 20v-6h8v6" Size="14" Margin="0,0,6,0"/>
                            <AccessText Text="_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode bar: the current task's on-page tools and what they do and do not change. -->
        <Border x:Name="EditToolbar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource ModeBarBrush}" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="0,0,0,1"
                Padding="12,5,10,5" AutomationProperties.Name="Page editing tools">
            <DockPanel>
                <TextBlock x:Name="ToolHint" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" FontSize="{DynamicResource SmallFontSize}"
                           Visibility="{DynamicResource MenuLabelVisibility}" AutomationProperties.Name="Editing tool instructions"/>
                <TextBlock x:Name="ModeLabel" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Current editing mode"/>
                <WrapPanel x:Name="ToolButtons" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="SelectTool" Tag="Select" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Select and copy text" AutomationProperties.Name="Select text tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M5.5 3.5l13 7-5.6 1.8-2.9 5.7z" Size="14"/><TextBlock Text="Select" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <Rectangle Width="1" Height="18" Margin="2,0,6,0" Fill="{DynamicResource ChromeLineBrush}"/>
                    <RadioButton x:Name="EditTextTool" Tag="EditText" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Click existing text on the page and type to change it" AutomationProperties.Name="Edit existing text tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 20h4L19 9l-4-4L4 16zM13 7l4 4" Size="14"/><TextBlock Text="Edit text" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AddTextTool" Tag="AddText" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Click anywhere on the page and type new text" AutomationProperties.Name="Add new text tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M5 7V4.5h11V7M10.5 4.5v15M8 19.5h5M18.5 13v7M15 16.5h7" Size="14"/><TextBlock Text="Add text" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <Rectangle Width="1" Height="18" Margin="2,0,6,0" Fill="{DynamicResource ChromeLineBrush}"/>
                    <RadioButton x:Name="HighlightTool" Tag="Highlight" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag across text to highlight it" AutomationProperties.Name="Highlight text tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M15 4.5l4.5 4.5-8 8H7v-4.5zM4 21h16" Size="14"/><TextBlock Text="Highlight" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UnderlineTool" Tag="Underline" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag across text to underline it" AutomationProperties.Name="Underline text tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M7 4v7a5 5 0 0 0 10 0V4M5 20h14" Size="14"/><TextBlock Text="Underline" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="StrikeoutTool" Tag="Strikeout" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag across text to strike it out" AutomationProperties.Name="Strikeout text tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 12h16M16 7c-1-1.5-2.5-2-4-2-2.5 0-4.5 1.3-4.5 3.3M8 17c1 1.5 2.5 2 4 2 2.5 0 4.5-1.3 4.5-3.3" Size="14"/><TextBlock Text="Strikeout" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NoteTool" Tag="Note" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Click to place a sticky note and type the comment" AutomationProperties.Name="Sticky note tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 5.5h16v11h-9l-5 4v-4H4z" Size="14"/><TextBlock Text="Note" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <Rectangle Width="1" Height="18" Margin="2,0,6,0" Fill="{DynamicResource ChromeLineBrush}"/>
                    <RadioButton x:Name="PenTool" Tag="Pen" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Draw freehand on the page" AutomationProperties.Name="Freehand pen tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M2.5 16c3-11 6-11 8-4s5 6 7-3c1-4 3-4 4.5-1" Size="14"/><TextBlock Text="Pen" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LineTool" Tag="Line" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag to draw a straight line" AutomationProperties.Name="Line tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 19L20 5" Size="14"/><TextBlock Text="Line" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ArrowTool" Tag="Arrow" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag to draw an arrow pointing where you release" AutomationProperties.Name="Arrow tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 19L20 5M11 5h9v9" Size="14"/><TextBlock Text="Arrow" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RectangleTool" Tag="Rectangle" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag to draw a rectangle" AutomationProperties.Name="Rectangle tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M3.5 6h17v12h-17z" Size="14"/><TextBlock Text="Rectangle" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="EllipseTool" Tag="Ellipse" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag to draw an ellipse" AutomationProperties.Name="Ellipse tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M12 18.5c4.7 0 8.5-2.9 8.5-6.5S16.7 5.5 12 5.5 3.5 8.4 3.5 12s3.8 6.5 8.5 6.5z" Size="14"/><TextBlock Text="Ellipse" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TextBoxTool" Tag="TextBox" Style="{StaticResource PageToolButton}" Checked="PageTool_Checked" ToolTip="Drag a box, then type one line of text inside it" AutomationProperties.Name="Text box tool">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M3.5 5.5h17v13h-17zM8 9.5h8M12 9.5v6" Size="14"/><TextBlock Text="Text box" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </RadioButton>
                    <Rectangle Width="1" Height="18" Margin="2,0,6,0" Fill="{DynamicResource ChromeLineBrush}"/>
                    <Button x:Name="ManageAnnotationsButton" Style="{StaticResource ChipButton}" Click="ManageAnnotations_Click" ToolTip="Edit note text or delete notes and text markup already on this page"
                            AutomationProperties.Name="Manage existing annotations on the current page">
                        <StackPanel Orientation="Horizontal"><local:StrokeIcon Data="M4 6h16M4 12h16M4 18h10" Size="14"/><TextBlock Text="Manage" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel x:Name="StylePanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"
                            AutomationProperties.Name="Drawing color and line width">
                    <StackPanel x:Name="StrokeSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StrokeWidthChoice" Width="72" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource SmallFontSize}"
                              ToolTip="Line width for this tool" AutomationProperties.Name="Line width"/>
                    <StackPanel x:Name="TextStylePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <ComboBox x:Name="TextFontChoice" Width="150" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource SmallFontSize}"
                                  ToolTip="Font for new text" AutomationProperties.Name="Text font"/>
                        <ComboBox x:Name="TextSizeChoice" Width="64" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource SmallFontSize}"
                                  ToolTip="Text size in points" AutomationProperties.Name="Text size"/>
                        <ToggleButton x:Name="TextBoldToggle" Content="B" FontWeight="Bold" Width="28" Margin="6,0,0,0" ToolTip="Bold" AutomationProperties.Name="Bold text"/>
                        <ToggleButton x:Name="TextItalicToggle" Content="I" FontStyle="Italic" Width="28" Margin="2,0,0,0" ToolTip="Italic" AutomationProperties.Name="Italic text"/>
                        <ComboBox x:Name="TextAlignChoice" Width="76" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource SmallFontSize}"
                                  ToolTip="Alignment inside the text box" AutomationProperties.Name="Text alignment"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <local:StrokeIcon x:Name="ModeNoticeIcon" Data="M12 8v5M12 16.5h.01M12 3l9.5 17h-19z" Size="14" Margin="0,0,6,0" TextElement.Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="ModeNotice" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               AutomationProperties.Name="Editing mode note"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Find bar, opened with Find or Ctrl+F. -->
        <Border x:Name="FindBar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="0,0,0,1" Padding="12,5,10,5"
                AutomationProperties.Name="Find in document">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseFind_Click" ToolTip="Close find (Esc)" AutomationProperties.Name="Close find bar">
                    <local:StrokeIcon Data="M6 6l12 12M18 6L6 18" Size="14"/>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="260">
                        <TextBox x:Name="SearchBox" Padding="28,2,8,2" BorderBrush="{DynamicResource AccentBrush}" AutomationProperties.Name="Search document text" KeyDown="Search_KeyDown"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Find in document. Enter finds the next match, Shift+Enter the previous one."/>
                        <local:StrokeIcon Data="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM15.5 15.5L20 20" Size="14" HorizontalAlignment="Left" Margin="9,0,0,0" TextElement.Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                    <ToggleButton x:Name="MatchCaseToggle" Content="Match case" Style="{StaticResource ChipToggle}" Click="MatchOption_Click" Margin="8,0,0,0"
                                  ToolTip="Match case (Alt+C): only find text with the same capitalization" AutomationProperties.Name="Match case" AutomationProperties.AcceleratorKey="Alt+C"/>
                    <ToggleButton x:Name="WholeWordToggle" Content="Whole word" Style="{StaticResource ChipToggle}" Click="MatchOption_Click" Margin="4,0,0,0"
                                  ToolTip="Whole word (Alt+W): ignore matches inside longer words" AutomationProperties.Name="Whole word" AutomationProperties.AcceleratorKey="Alt+W"/>
                    <TextBlock x:Name="MatchCount" VerticalAlignment="Center" Margin="12,0,4,0" MinWidth="56" FontSize="{DynamicResource SmallFontSize}"
                               AutomationProperties.Name="Match count" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="PreviousMatchButton" Style="{StaticResource IconButton}" Click="PreviousMatch_Click" ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match">
                        <local:StrokeIcon Data="M6 15l6-6 6 6" Size="14"/>
                    </Button>
                    <Button x:Name="NextMatchButton" Style="{StaticResource IconButton}" Click="Search_Click" ToolTip="Next match (Enter)" AutomationProperties.Name="Search PDF">
                        <local:StrokeIcon Data="M6 9l6 6 6-6" Size="14"/>
                    </Button>
                    <TextBlock x:Name="MatchPages" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}"
                               AutomationProperties.Name="Pages with matches"/>
                    <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Margin="12,0" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="240" MaxWidth="360"/>
                <ColumnDefinition x:Name="NavigationGripColumn" Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PropertiesGripColumn" Width="5"/>
                <ColumnDefinition x:Name="PropertiesColumn" Width="280" MaxWidth="400"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="NavigationPanel" Background="{DynamicResource PanelBrush}" AutomationProperties.Name="Document navigation">
                <TabControl Style="{StaticResource PanelTabs}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Navigation views">
                    <TabItem Header="Pages" Padding="6,0"><ListBox x:Name="ThumbnailList" TextElement.FontWeight="Normal" MouseDoubleClick="Thumbnail_DoubleClick" Padding="6" ItemContainerStyle="{StaticResource ThumbnailItem}" AutomationProperties.Name="Page thumbnails">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <Border Background="White" Width="64" Height="83" HorizontalAlignment="Center" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="1"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                            <TextBlock Text="{Binding DisplayNumber}" HorizontalAlignment="Center" FontSize="{DynamicResource SmallFontSize}" Margin="0,5,0,0"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox></TabItem>
                    <TabItem x:Name="FieldsTab" Header="Fields" Padding="6,0" Selector.Selected="FieldsTab_Selected" AutomationProperties.Name="Form fields">
                        <DockPanel Margin="10,8,10,10" TextElement.FontWeight="Normal">
                            <TextBlock x:Name="FieldsStatus" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}"
                                       Text="Open a PDF form to fill its fields here." AutomationProperties.Name="Form fields status"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Reload" Click="ReloadFields_Click" Padding="10,2" Margin="0,0,6,0" AutomationProperties.Name="Reload form fields"/>
                                <Button x:Name="ApplyFieldsButton" Content="Apply" Style="{StaticResource PrimaryButton}" Click="ApplyFields_Click" IsEnabled="False"
                                        ToolTip="Fill all changed fields as one change (Ctrl+Z undoes it)" AutomationProperties.Name="Apply form field values"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FieldsHost"/></ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Bookmarks" Padding="6,0"><ListBox x:Name="BookmarkList" TextElement.FontWeight="Normal" MouseDoubleClick="Bookmark_DoubleClick" Padding="6" AutomationProperties.Name="PDF bookmarks">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox></TabItem>
                    <TabItem Header="Documents" Padding="6,0"><ListBox x:Name="OpenDocumentList" TextElement.FontWeight="Normal" SelectionChanged="DocumentSelection_Changed" Padding="6" AutomationProperties.Name="Open document list">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox></TabItem>
                </TabControl>
            </Border>
            <GridSplitter x:Name="NavigationGrip" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ChromeLineBrush}"
                          Focusable="True" FocusVisualStyle="{StaticResource KeyboardFocusVisual}" AutomationProperties.Name="Resize navigation panel"/>
            <Grid Grid.Column="2" Background="{DynamicResource CanvasBrush}">
                <Grid x:Name="DocumentView" Visibility="Collapsed">
                    <ScrollViewer x:Name="DocumentScroll" Padding="24,28,24,40" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="DocumentScroll_Changed"
                                  AutomationProperties.Name="Document canvas">
                        <StackPanel x:Name="PageStack" HorizontalAlignment="Center">
                            <Border x:Name="PageCard0" Background="White" Margin="0,0,0,16" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="1">
                                <Grid><Image x:Name="PageImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.Name="Rendered PDF page"/><Canvas x:Name="SelectionLayer0" Background="Transparent" Focusable="True" PreviewMouseLeftButtonDown="Selection_MouseDown" PreviewMouseMove="Selection_MouseMove" PreviewMouseLeftButtonUp="Selection_MouseUp"/></Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="StartScreen" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" Margin="36,48" HorizontalAlignment="Center">
                        <TextBlock Text="Your PDFs. Your workspace." FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Open a PDF or drop files anywhere in this window." FontSize="18" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <Button x:Name="StartOpenButton" Content="Open PDF" Style="{StaticResource PrimaryButton}" Command="ApplicationCommands.Open" CommandTarget="{Binding ElementName=RootWindow}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Open a PDF from the start screen"/>
                        <Button x:Name="StartCombineButton" Content="Combine PDFs" Click="Combine_Click" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="Combine PDF files from the start screen"/>
                        <Border Margin="0,18,0,0" Padding="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource PanelBrush}">
                            <StackPanel>
                                <TextBlock Text="Drop PDFs here" FontWeight="SemiBold"/>
                                <TextBlock Text="Open one or more PDF files in separate tabs. Your original files stay intact until you save changes." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="VIEW, SEARCH AND MAKE BASIC CHANGES" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,24,0,8"/>
                        <TextBlock Text="Read and search PDFs, edit supported text, add text or images, apply markup, and organize pages: reorder, duplicate, delete, rotate, import, extract, split, or insert pages. Save or undo supported changes; originals stay intact until you save edits." TextWrapping="Wrap"/>
                        <DockPanel Margin="0,34,0,10">
                            <Button DockPanel.Dock="Right" Content="Clear history" Click="ClearHistory_Click" Padding="8,4" AutomationProperties.Name="Clear recent file history"/>
                            <TextBlock Text="RECENT FILES" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="RecentEmpty" Text="Recently opened PDFs will appear here." Foreground="{DynamicResource MutedBrush}" Margin="0,10"/>
                        <ListBox x:Name="RecentList" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown" Background="Transparent" AutomationProperties.Name="Recent PDF files">
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel ToolTip="{Binding FullPath}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Availability}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Open selected recent file" Click="OpenRecent_Click" HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.Name="Open selected recent PDF"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <GridSplitter x:Name="PropertiesGrip" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ChromeLineBrush}"
                          Focusable="True" FocusVisualStyle="{StaticResource KeyboardFocusVisual}" AutomationProperties.Name="Resize properties panel"/>
            <Border x:Name="PropertiesPanel" Grid.Column="4" Background="{DynamicResource PanelBrush}" AutomationProperties.Name="Document properties">
                <TabControl x:Name="SidePanelTabs" Style="{StaticResource PanelTabs}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                            SelectionChanged="SidePanelTabs_SelectionChanged" AutomationProperties.Name="Side panel views">
                    <TabItem x:Name="AnnotationsTab" Header="Annotations" Padding="6,0" ToolTip="Every annotation in the document" AutomationProperties.Name="Annotations">
                        <DockPanel Margin="10,8,10,10" TextElement.FontWeight="Normal">
                            <TextBlock x:Name="AnnotationsStatus" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                                       Text="Open a document to list its annotations." AutomationProperties.Name="Annotations status"/>
                            <ListBox x:Name="AnnotationList" MouseUp="SidePanelEntry_Activated" KeyDown="SidePanelEntry_KeyDown" AutomationProperties.Name="Annotations in this document">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding PageLabel}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="PageContentsTab" Header="On this page" Padding="6,0" ToolTip="Text objects, images and annotations on the current page" AutomationProperties.Name="On this page">
                        <DockPanel Margin="10,8,10,10" TextElement.FontWeight="Normal">
                            <TextBlock x:Name="PageContentsStatus" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                                       Text="Open a document to list this page's contents." AutomationProperties.Name="Page contents status"/>
                            <ListBox x:Name="PageContentList" AutomationProperties.Name="Contents of the current page">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="PropertiesTab" Header="Properties" Padding="6,0" IsSelected="True" ToolTip="Document and page properties" AutomationProperties.Name="Properties">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.FontWeight="Normal">
                        <StackPanel Margin="12,12,12,18">
                            <TextBlock Text="Document" Style="{StaticResource SectionLabel}"/>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="File" Style="{StaticResource PropertyName}"/>
                                <TextBlock x:Name="PropertiesFile" Text="Open a document to inspect it." Style="{StaticResource PropertyValue}"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Location" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertyLocation" Style="{StaticResource PropertyValue}"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Pages" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertyPages" Style="{StaticResource PropertyValue}"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Status" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertyStatus" Style="{StaticResource PropertyValue}"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Signature" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertySignature" Style="{StaticResource PropertyValue}" TextWrapping="Wrap" TextTrimming="None"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Original file" Style="{StaticResource PropertyName}"/><TextBlock Text="Kept until you save" Style="{StaticResource PropertyValue}"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Undo history" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertyHistory" Style="{StaticResource PropertyValue}"
                                       ToolTip="Undo steps kept for this document and the disk space they use. File → Free undo storage removes older steps."/></DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource ChromeLineBrush}" Margin="0,12"/>
                            <TextBlock x:Name="PropertyPageHeader" Text="Page" Style="{StaticResource SectionLabel}"/>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Size" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertySize" Style="{StaticResource PropertyValue}"/></DockPanel>
                            <DockPanel Style="{StaticResource PropertyRow}"><TextBlock Text="Rotation" Style="{StaticResource PropertyName}"/><TextBlock x:Name="PropertyRotation" Style="{StaticResource PropertyValue}"/></DockPanel>
                            <Rectangle Height="1" Fill="{DynamicResource ChromeLineBrush}" Margin="0,12"/>
                            <StackPanel x:Name="TextEditorPanel">
                                <TextBlock Text="Add text at exact position" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="New basic Latin text on the current page, placed by PDF coordinates. Replacing text is not permanent redaction." Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBox x:Name="NewText" MaxLength="500" AutomationProperties.Name="Text to add"/>
                                <Grid Margin="0,8,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="X (pt)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TextX" Text="72" AutomationProperties.Name="Text horizontal position in PDF points"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Y (pt)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TextY" Text="120" AutomationProperties.Name="Text vertical position in PDF points"/></StackPanel>
                                </Grid>
                                <Button x:Name="AddButton" Content="Add text" Style="{StaticResource PrimaryButton}" Click="Add_Click" HorizontalAlignment="Left" AutomationProperties.Name="Add text to current page"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status bar: activity and document state on the left, fit and zoom on the right. -->
        <Border Grid.Row="5" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ChromeLineBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="LayoutChoice" Width="132" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{DynamicResource SmallFontSize}"
                              ToolTip="Page layout: continuous scrolling, one page at a time, or two pages side by side" AutomationProperties.Name="Page layout"/>
                    <Button x:Name="FitWidthButton" Content="Fit width" ToolTip="Fit width (Ctrl+2)" Click="FitWidth_Click" Background="Transparent" BorderBrush="Transparent" FontSize="{DynamicResource SmallFontSize}" Padding="6,0" AutomationProperties.Name="Fit page width"/>
                    <Button x:Name="FitPageButton" Content="Fit page" ToolTip="Fit page (Ctrl+0)" Click="FitPage_Click" Background="Transparent" BorderBrush="Transparent" FontSize="{DynamicResource SmallFontSize}" Padding="6,0" AutomationProperties.Name="Fit whole page"/>
                    <Rectangle Style="{StaticResource ChromeSeparator}" Height="14"/>
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+minus or Ctrl+mouse wheel)" AutomationProperties.Name="Zoom out">
                        <local:StrokeIcon Data="M5 12h14" Size="13"/>
                    </Button>
                    <TextBlock x:Name="ZoomValue" Text="100%" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource SmallFontSize}" AutomationProperties.Name="Current zoom"/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+plus or Ctrl+mouse wheel). Ctrl+1 shows actual size." AutomationProperties.Name="Zoom in">
                        <local:StrokeIcon Data="M12 5v14M5 12h14" Size="13"/>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ProgressBar x:Name="BusyProgress" Width="120" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ChromeLineBrush}" BorderThickness="0"/>
                    <TextBlock x:Name="OperationStatus" Text="Ready" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="Active operation"/>
                    <Rectangle Style="{StaticResource ChromeSeparator}" Height="14" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Status" Text="Open a PDF. Original files are preserved by default." VerticalAlignment="Center" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" Margin="0,4" AutomationProperties.Name="Document status"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
